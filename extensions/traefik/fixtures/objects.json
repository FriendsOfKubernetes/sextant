{
  "_source": "Shapes from Traefik's documentation (routing/providers/kubernetes-crd, middlewares, TLS) and pkg/provider/kubernetes/crd/traefikio/v1alpha1; names adapted.",
  "ingressRoute": {
    "apiVersion": "traefik.io/v1alpha1",
    "kind": "IngressRoute",
    "metadata": {
      "name": "myingressroute",
      "namespace": "default",
      "uid": "uid-myingressroute",
      "resourceVersion": "1",
      "creationTimestamp": "2026-10-01T10:00:00Z"
    },
    "spec": {
      "entryPoints": [
        "websecure"
      ],
      "routes": [
        {
          "match": "Host(`foo.example.net`) && PathPrefix(`/bar`)",
          "kind": "Rule",
          "priority": 10,
          "middlewares": [
            {
              "name": "secured",
              "namespace": "default"
            }
          ],
          "services": [
            {
              "kind": "Service",
              "name": "foo",
              "namespace": "default",
              "port": 80,
              "weight": 10,
              "passHostHeader": true
            }
          ]
        },
        {
          "match": "Host(`foo.example.net`) && PathPrefix(`/wrr`)",
          "kind": "Rule",
          "services": [
            {
              "kind": "TraefikService",
              "name": "wrr1"
            }
          ]
        },
        {
          "match": "PathPrefix(`/dashboard`)",
          "kind": "Rule",
          "services": [
            {
              "kind": "TraefikService",
              "name": "api@internal"
            }
          ]
        }
      ],
      "tls": {
        "secretName": "supersecret",
        "options": {
          "name": "opt",
          "namespace": "default"
        },
        "domains": [
          {
            "main": "foo.example.net"
          }
        ]
      }
    }
  },
