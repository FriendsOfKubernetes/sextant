{
  "$schema": "../../crates/sextant-core/src/extensions/manifest.schema.json",
  "id": "sextant.contour",
  "name": "Contour",
  "version": "1.0.0",
  "description": "Contour's HTTPProxies, TLSCertificateDelegations and ExtensionServices: each proxy's state as Contour writes it with its first error, its virtual host and TLS, routes with each service's share, includes and the delegation tree; problems of invalid and orphaned proxies. Read-only.",
  "author": "Sextant",
  "sextantApi": 4,
  "entry": "index.html",
  "icon": "contour",
  "permissions": {
    "clusters": {
      "type": "all"
    },
    "rules": [
      {
        "namespaces": {
          "type": "all"
        },
        "kinds": {
          "type": "only",
          "kinds": [
            {
              "group": "projectcontour.io",
              "kind": "HTTPProxy"
            },
            {
              "group": "projectcontour.io",
              "kind": "TLSCertificateDelegation"
            },
            {
              "group": "projectcontour.io",
              "kind": "ExtensionService"
            }
          ]
        },
        "actions": [
          "read"
        ]
      }
    ]
  },
  "contributes": {
    "kinds": [
      {
        "group": "projectcontour.io",
        "kind": "HTTPProxy",
        "section": "contour",
        "title": "HTTP Proxies",
        "icon": "contourProxy",
        "order": 10,
        "printerColumns": false,
        "problemWhen": {
          "type": "any",
          "of": [
            {
              "type": "any",
              "of": [
                {
                  "type": "equals",
                  "path": ".status.currentStatus",
                  "value": "invalid"
                },
                {
                  "type": "all",
                  "of": [
                    {
                      "type": "not",
                      "of": {
                        "type": "in",
                        "path": ".status.currentStatus",
                        "values": [
                          "valid",
                          "invalid",
                          "orphaned"
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "conditionType": "Valid",
                      "status": "False"
                    },
                    {
                      "type": "absent",
                      "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                    }
                  ]
                }
              ]
            },
            {
              "type": "any",
              "of": [
                {
                  "type": "equals",
                  "path": ".status.currentStatus",
                  "value": "orphaned"
                },
                {
                  "type": "all",
                  "of": [
                    {
                      "type": "not",
                      "of": {
                        "type": "in",
                        "path": ".status.currentStatus",
                        "values": [
                          "valid",
                          "invalid",
                          "orphaned"
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "conditionType": "Valid",
                      "status": "False"
                    },
                    {
                      "type": "exists",
                      "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "group": "projectcontour.io",
        "kind": "TLSCertificateDelegation",
        "section": "contour",
        "title": "TLS Certificate Delegations",
        "icon": "contourDelegation",
        "order": 20,
        "printerColumns": false
      },
      {
        "group": "projectcontour.io",
        "kind": "ExtensionService",
        "section": "contour",
        "title": "Extension Services",
        "icon": "contourExtension",
        "order": 30,
        "printerColumns": false
      }
    ],
    "sections": [
      {
        "section": "contour",
        "title": "Contour",
        "icon": "contour",
        "after": "traefik"
      }
    ],
    "sectionBadges": [
      {
        "section": "contour",
        "rules": [
          "proxy-invalid",
          "proxy-orphaned"
        ],
        "label": {
          "one": "{{count}} HTTPProxy needs attention",
          "other": "{{count}} HTTPProxies need attention"
        }
      }
    ],
    "detailsSections": [
      {
        "id": "http-proxy",
        "title": "HTTPProxy",
        "kinds": [
          {
            "group": "projectcontour.io",
            "kind": "HTTPProxy"
          }
        ],
        "placement": "section",
        "order": 20,
        "heading": false
      },
      {
        "id": "tls-delegation",
        "title": "TLSCertificateDelegation",
        "kinds": [
          {
            "group": "projectcontour.io",
            "kind": "TLSCertificateDelegation"
          }
        ],
        "placement": "section",
        "order": 20,
        "heading": false
      },
      {
        "id": "extension-service",
        "title": "ExtensionService",
        "kinds": [
          {
            "group": "projectcontour.io",
            "kind": "ExtensionService"
          }
        ],
        "placement": "section",
        "order": 20,
        "heading": false
      }
    ],
    "columns": [
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "id": "proxy-status",
        "title": "Status",
        "paths": [
          ".status.currentStatus"
        ],
        "width": "110px",
        "cases": [
          {
            "when": {
              "type": "any",
              "of": [
                {
                  "type": "equals",
                  "path": ".status.currentStatus",
                  "value": "valid"
                },
                {
                  "type": "all",
                  "of": [
                    {
                      "type": "not",
                      "of": {
                        "type": "in",
                        "path": ".status.currentStatus",
                        "values": [
                          "valid",
                          "invalid",
                          "orphaned"
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "conditionType": "Valid",
                      "status": "True"
                    }
                  ]
                }
              ]
            },
            "text": "Valid",
            "tone": "ok",
            "value": "valid"
          },
          {
            "when": {
              "type": "any",
              "of": [
                {
                  "type": "equals",
                  "path": ".status.currentStatus",
                  "value": "invalid"
                },
                {
                  "type": "all",
                  "of": [
                    {
                      "type": "not",
                      "of": {
                        "type": "in",
                        "path": ".status.currentStatus",
                        "values": [
                          "valid",
                          "invalid",
                          "orphaned"
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "conditionType": "Valid",
                      "status": "False"
                    },
                    {
                      "type": "absent",
                      "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                    }
                  ]
                }
              ]
            },
            "text": "Invalid",
            "tone": "error",
            "value": "invalid"
          },
          {
            "when": {
              "type": "any",
              "of": [
                {
                  "type": "equals",
                  "path": ".status.currentStatus",
                  "value": "orphaned"
                },
                {
                  "type": "all",
                  "of": [
                    {
                      "type": "not",
                      "of": {
                        "type": "in",
                        "path": ".status.currentStatus",
                        "values": [
                          "valid",
                          "invalid",
                          "orphaned"
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "conditionType": "Valid",
                      "status": "False"
                    },
                    {
                      "type": "exists",
                      "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                    }
                  ]
                }
              ]
            },
            "text": "Orphaned",
            "tone": "error",
            "value": "orphaned"
          },
          {
            "when": {
              "type": "exists",
              "path": ".metadata.name"
            },
            "text": "Waiting for Contour",
            "tone": "warning",
            "value": "pending"
          }
        ],
        "filterBy": "value",
        "afterColumn": "namespace"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "id": "proxy-fqdn",
        "title": "Host",
        "paths": [
          ".spec.virtualhost.fqdn"
        ],
        "width": "minmax(140px, 2fr)",
        "afterColumn": "proxy-status"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "id": "proxy-tls",
        "title": "TLS Secret",
        "paths": [
          ".spec.virtualhost.tls.secretName"
        ],
        "width": "minmax(120px, 1fr)",
        "cases": [
          {
            "when": {
              "type": "equals",
              "path": ".spec.virtualhost.tls.passthrough",
              "value": true
            },
            "text": "passthrough"
          },
          {
            "when": {
              "type": "equals",
              "path": ".spec.virtualhost.tls.secretName",
              "value": ""
            },
            "text": "",
            "value": "{{.spec.virtualhost.tls.secretName|after:/}}"
          },
          {
            "when": {
              "type": "startsWith",
              "path": ".spec.virtualhost.tls.secretName",
              "values": [
                "{{.metadata.namespace}}/"
              ]
            },
            "text": "{{.spec.virtualhost.tls.secretName|after:/}}"
          },
          {
            "when": {
              "type": "startsWith",
              "path": ".spec.virtualhost.tls.secretName",
              "values": [
                "{{.metadata.namespace}}/"
              ]
            },
            "text": "",
            "value": "{{.spec.virtualhost.tls.secretName|after:/}}"
          }
        ],
        "afterColumn": "proxy-fqdn"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "id": "proxy-includes",
        "title": "Includes",
        "paths": [
          ".spec.includes[name!=\"\",*].name|count"
        ],
        "format": "number",
        "width": "90px",
        "cases": [
          {
            "when": {
              "type": "exists",
              "path": ".spec.tcpproxy.include.name",
              "nonEmpty": true
            },
            "text": "{{.spec.includes[name!=\"\",*].name + .spec.tcpproxy.include.name|count}}",
            "value": "{{.spec.includes[name!=\"\",*].name + .spec.tcpproxy.include.name|count}}"
          },
          {
            "when": {
              "type": "all",
              "of": [
                {
                  "type": "absent",
                  "path": ".spec.tcpproxy.include"
                },
                {
                  "type": "exists",
                  "path": ".spec.tcpproxy.includes.name",
                  "nonEmpty": true
                }
              ]
            },
            "text": "{{.spec.includes[name!=\"\",*].name + .spec.tcpproxy.includes.name|count}}",
            "value": "{{.spec.includes[name!=\"\",*].name + .spec.tcpproxy.includes.name|count}}"
          },
          {
            "when": {
              "type": "not",
              "of": {
                "type": "above",
                "path": ".spec.includes[name!=\"\",*].name|count",
                "value": 0
              }
            },
            "text": "",
            "value": "{{.spec.includes[0].name}}"
          }
        ],
        "afterColumn": "proxy-tls"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "id": "proxy-routes",
        "title": "Routes",
        "paths": [
          ".spec.routes"
        ],
        "format": "count",
        "width": "80px",
        "cases": [
          {
            "when": {
              "type": "equals",
              "path": ".spec.routes|count",
              "value": 0
            },
            "text": "",
            "value": "{{.spec.routes[0]}}"
          }
        ],
        "afterColumn": "proxy-includes"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "id": "proxy-reason",
        "title": "Reason",
        "paths": [
          ".status.conditions[type=\"Valid\"].errors[0].reason"
        ],
        "width": "minmax(100px, 1fr)",
        "cases": [
          {
            "when": {
              "type": "any",
              "of": [
                {
                  "type": "equals",
                  "path": ".status.currentStatus",
                  "value": "orphaned"
                },
                {
                  "type": "all",
                  "of": [
                    {
                      "type": "not",
                      "of": {
                        "type": "in",
                        "path": ".status.currentStatus",
                        "values": [
                          "valid",
                          "invalid",
                          "orphaned"
                        ]
                      }
                    },
                    {
                      "type": "condition",
                      "conditionType": "Valid",
                      "status": "False"
                    },
                    {
                      "type": "exists",
                      "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                    }
                  ]
                }
              ]
            },
            "text": "Orphaned"
          },
          {
            "when": {
              "type": "not",
              "of": {
                "type": "exists",
                "path": ".status.conditions[type=\"Valid\"].status",
                "nonEmpty": true
              }
            },
            "text": "",
            "value": "{{.status.conditions[type=\"Valid\"].status}}"
          }
        ],
        "afterColumn": "proxy-routes"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "TLSCertificateDelegation"
        },
        "id": "delegation-secrets",
        "title": "Secrets",
        "paths": [
          ".spec.delegations[*].secretName"
        ],
        "format": "list",
        "separator": ", ",
        "width": "minmax(140px, 2fr)",
        "afterColumn": "namespace"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "TLSCertificateDelegation"
        },
        "id": "delegation-targets",
        "title": "Target namespaces",
        "paths": [
          ".spec.delegations[secretName!=\"\",*].targetNamespaces[*]"
        ],
        "format": "list",
        "joinPaths": true,
        "separator": ", ",
        "width": "minmax(140px, 2fr)",
        "afterColumn": "delegation-secrets"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "ExtensionService"
        },
        "id": "extension-status",
        "title": "Status",
        "paths": [
          ".status.conditions[type=\"Valid\"].status"
        ],
        "width": "110px",
        "cases": [
          {
            "when": {
              "type": "condition",
              "conditionType": "Valid",
              "status": "True"
            },
            "text": "Ready",
            "tone": "ok",
            "value": "ready"
          },
          {
            "when": {
              "type": "condition",
              "conditionType": "Valid",
              "status": "False"
            },
            "text": "Failed",
            "tone": "error",
            "value": "failed"
          },
          {
            "when": {
              "type": "condition",
              "conditionType": "Valid",
              "status": "Unknown"
            },
            "text": "Progressing",
            "tone": "warning",
            "value": "progressing"
          },
          {
            "when": {
              "type": "exists",
              "path": ".metadata.name"
            },
            "text": "Unknown",
            "tone": "muted",
            "value": "unknown"
          }
        ],
        "filterBy": "value",
        "afterColumn": "namespace"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "ExtensionService"
        },
        "id": "extension-services",
        "title": "Services",
        "paths": [
          ".spec.services"
        ],
        "format": "list",
        "items": {
          "cases": [
            {
              "when": {
                "type": "all",
                "of": [
                  {
                    "type": "exists",
                    "path": ".name",
                    "nonEmpty": true
                  },
                  {
                    "type": "exists",
                    "path": ".port"
                  }
                ]
              },
              "text": "{{.name}}:{{.port}}"
            },
            {
              "when": {
                "type": "exists",
                "path": ".name",
                "nonEmpty": true
              },
              "text": "{{.name}}:"
            }
          ],
          "separator": ", "
        },
        "width": "minmax(140px, 2fr)",
        "afterColumn": "extension-status"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "ExtensionService"
        },
        "id": "extension-protocol",
        "title": "Protocol",
        "paths": [
          ".spec.protocol"
        ],
        "width": "90px",
        "afterColumn": "extension-services"
      },
      {
        "kind": {
          "group": "projectcontour.io",
          "kind": "ExtensionService"
        },
        "id": "extension-reason",
        "title": "Reason",
        "paths": [
          ".status.conditions[type=\"Valid\"].errors[0].reason"
        ],
        "width": "minmax(100px, 1fr)",
        "cases": [
          {
            "when": {
              "type": "not",
              "of": {
                "type": "exists",
                "path": ".status.conditions[type=\"Valid\"].status",
                "nonEmpty": true
              }
            },
            "text": "",
            "value": "{{.status.conditions[type=\"Valid\"].status}}"
          }
        ],
        "afterColumn": "extension-protocol"
      }
    ],
    "problems": [
      {
        "id": "proxy-invalid",
        "title": "HTTPProxy invalid",
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "when": {
          "type": "any",
          "of": [
            {
              "type": "equals",
              "path": ".status.currentStatus",
              "value": "invalid"
            },
            {
              "type": "all",
              "of": [
                {
                  "type": "not",
                  "of": {
                    "type": "in",
                    "path": ".status.currentStatus",
                    "values": [
                      "valid",
                      "invalid",
                      "orphaned"
                    ]
                  }
                },
                {
                  "type": "condition",
                  "conditionType": "Valid",
                  "status": "False"
                },
                {
                  "type": "absent",
                  "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                }
              ]
            }
          ]
        },
        "since": ".status.conditions[type=\"Valid\"].lastTransitionTime",
        "graceMinutes": 2,
        "group": "invalid",
        "reason": "{{.status.conditions[type=\"Valid\"].errors[0].reason}}",
        "reasonOr": "Invalid",
        "message": "{{.status.conditions[type=\"Valid\"].errors[0].message ?? .status.description}}"
      },
      {
        "id": "proxy-orphaned",
        "title": "HTTPProxy orphaned",
        "kind": {
          "group": "projectcontour.io",
          "kind": "HTTPProxy"
        },
        "when": {
          "type": "any",
          "of": [
            {
              "type": "equals",
              "path": ".status.currentStatus",
              "value": "orphaned"
            },
            {
              "type": "all",
              "of": [
                {
                  "type": "not",
                  "of": {
                    "type": "in",
                    "path": ".status.currentStatus",
                    "values": [
                      "valid",
                      "invalid",
                      "orphaned"
                    ]
                  }
                },
                {
                  "type": "condition",
                  "conditionType": "Valid",
                  "status": "False"
                },
                {
                  "type": "exists",
                  "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                }
              ]
            }
          ]
        },
        "since": ".status.conditions[type=\"Valid\"].lastTransitionTime",
        "graceMinutes": 2,
        "group": "orphaned",
        "reason": "Orphaned",
        "message": "{{.status.conditions[type=\"Valid\"].errors[0].message ?? .status.description}}",
        "toldThroughReferrer": {
          "path": ".spec.includes",
          "alsoPaths": [
            ".spec.tcpproxy.include",
            ".spec.tcpproxy.includes"
          ],
          "namePath": ".name",
          "namespacePath": ".namespace",
          "when": {
            "type": "any",
            "of": [
              {
                "type": "equals",
                "path": ".status.currentStatus",
                "value": "invalid"
              },
              {
                "type": "all",
                "of": [
                  {
                    "type": "not",
                    "of": {
                      "type": "in",
                      "path": ".status.currentStatus",
                      "values": [
                        "valid",
                        "invalid",
                        "orphaned"
                      ]
                    }
                  },
                  {
                    "type": "condition",
                    "conditionType": "Valid",
                    "status": "False"
                  },
                  {
                    "type": "absent",
                    "path": ".status.conditions[type=\"Valid\"].errors[type=\"Orphaned\"]"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "translations": {
