  {
    "apiVersion": "eventing.knative.dev/v1",
    "kind": "Trigger",
    "metadata": {
      "name": "orders-trigger",
      "namespace": "default",
      "uid": "t2",
      "creationTimestamp": "2026-10-20T10:00:00Z"
    },
    "spec": {
      "broker": "default",
      "filters": [
        {
          "exact": {
            "type": "com.example.order"
          }
        },
        {
          "any": [
            {
              "prefix": {
                "source": "/orders/"
              }
            },
            {
              "suffix": {
                "subject": ".json"
              }
            }
          ]
        }
      ],
      "filter": {
        "attributes": {
          "type": "old"
        }
      },
      "subscriber": {
        "ref": {
          "apiVersion": "v1",
          "kind": "Service",
          "name": "orders"
        },
        "uri": "/events"
      }
    },
    "status": {
      "conditions": [
        {
          "type": "BrokerReady",
          "status": "True",
          "lastTransitionTime": "2026-10-20T10:00:00Z"
        },
        {
          "type": "Ready",
          "status": "False",
          "lastTransitionTime": "2026-10-20T10:00:00Z",
          "reason": "Unable to get the Subscriber's URI",
          "message": "services \"orders\" not found"
        },
        {
          "type": "SubscriberResolved",
          "status": "False",
          "lastTransitionTime": "2026-10-20T10:00:00Z",
          "reason": "Unable to get the Subscriber's URI",
          "message": "services \"orders\" not found"
        }
      ]
    }
