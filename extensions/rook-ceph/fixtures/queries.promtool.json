          "eval_time": "3m",
          "exp_samples": [
            {
              "labels": "{state=\"up\"}",
              "value": 1
            },
            {
              "labels": "{state=\"in\"}",
              "value": 2
            },
            {
              "labels": "{state=\"total\"}",
              "value": 2
            }
          ]
        },
        {
          "expr": "sum by (__name__) (max by (__name__, pool_id) ({__name__=~\"ceph_pg_(total|active|clean|degraded|undersized|down|stale|peering|incomplete|inconsistent|recovering|backfilling|remapped)\",namespace=\"rook-ceph\"}))",
