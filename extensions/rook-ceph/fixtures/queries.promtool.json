        {
          "expr": "max(ceph_health_status{namespace=\"rook-ceph\"})",
          "eval_time": "3m",
          "exp_samples": [
            {
              "labels": "{}",
              "value": 1
            }
          ]
        },
        {
          "expr": "max by (__name__) ({__name__=~\"ceph_cluster_total_bytes|ceph_cluster_total_used_raw_bytes\",namespace=\"rook-ceph\"})",
          "eval_time": "3m",
          "exp_samples": [
            {
              "labels": "{__name__=\"ceph_cluster_total_bytes\"}",
              "value": 300
            },
            {
              "labels": "{__name__=\"ceph_cluster_total_used_raw_bytes\"}",
