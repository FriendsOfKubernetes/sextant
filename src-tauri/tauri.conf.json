{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sextant",
  "mainBinaryName": "sextant",
  "version": "0.26.4",
  "identifier": "dev.sextant.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sextant",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src sextant-ext: http://sextant-ext.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Desktop Kubernetes client",
    "longDescription": "Sextant is a desktop client for managing Kubernetes clusters: resources, logs, shells, port forwarding, metrics and Helm.",
    "copyright": "Sextant contributors, MIT OR Apache-2.0",
    "license": "MIT OR Apache-2.0",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "f2b05806-dabf-521c-add8-bda0f7263eb3"
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      },
      "rpm": {
        "depends": ["libwebkit2gtk-4.1.so.0()(64bit)", "libgtk-3.so.0()(64bit)"],
        "recommends": ["libayatana-appindicator3.so.1()(64bit)"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNzk1ODIwNDk1NjNFMzkKUldRNVBsWkpJRmg1YmxxTzhTa2NmcE9nSmFuZ3EwZC9iZ3JXdmNRbkIzQlRqb0R1U2dWdkNpU3oK",
      "endpoints": [
        "https://github.com/FriendsOfKubernetes/sextant/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
