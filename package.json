{
  "name": "sextant",
  "private": true,
  "version": "0.9.0",
  "description": "Sextant — desktop Kubernetes client",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/bindings.mjs clean && cargo test --workspace export_bindings && node scripts/bindings.mjs sync",
    "check": "node scripts/check-case-collisions.mjs && npm run check:version && npm run check:rust && npm run check:web && npm run sdk:check",
    "check:version": "node scripts/check-version.mjs && node --test scripts/check-version.test.mjs",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && node scripts/check-core-deps.mjs && node scripts/bindings.mjs clean && cargo test --workspace && node scripts/bindings.mjs verify",
    "check:web": "tsc --noEmit && tsc --noEmit -p e2e && eslint . && vitest run",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "sdk:check": "tsc -p sdk && tsc -p sdk/tsconfig.test.json && vitest run --config sdk/vitest.config.ts && node sdk/scripts/check.mjs",
    "sdk:build": "node sdk/scripts/build.mjs",
    "sdk:pack": "node sdk/scripts/pack.mjs",
    "sdk:sync-types": "node sdk/scripts/sync-types.mjs"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.15",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@uiw/codemirror-theme-dracula": "^4.25.12",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/codemirror-theme-nord": "^4.25.12",
    "@uiw/codemirror-theme-solarized": "^4.25.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "uplot": "^1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "webdriverio": "^10.0.2",
    "yaml": "^2.9.1"
  }
}
