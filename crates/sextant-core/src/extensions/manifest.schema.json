{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FriendsOfKubernetes/sextant/extension-manifest.schema.json",
  "title": "Sextant extension manifest (sextant-extension.json)",
  "description": "Sextant reads this schema itself (crates/sextant-core/src/extensions/schema.rs) and adds checks a schema cannot express: sextantApi must be one Sextant supports, contribution ids are unique per contribution type, and problem rules (sextantApi 2) have unique titles, judge at most 10 kinds, nest `all`/`any` at most 3 deep with 20 conditions per rule, and use field paths (`.a.b`, `[0]`, `[\"key\"]`) that read no Secret values or inline secret fields, at most 5 of them as `{{…}}` placeholders in a message. Metric queries (sextantApi 2) have unique parameter names, use each parameter as a `{{name}}` placeholder (a namespace, name or labelValue only inside a \"…\" string, a duration only outside strings) and have no comments. Translations (sextantApi 2) name texts this manifest has, keep their limits and, for a problem message, exactly the English placeholders. Rules across objects (sextantApi 3): `missing` is never inside `any` nor about Secrets, and its kind counts among the 10; `newestPer` is a label key. Commands (sextantApi 3) start with a word, every other argument a word or exactly `{{name}}` of a parameter, each parameter used; the target's label selector is `key=value` pairs and its container a DNS label. Section counters (sextantApi 3) are on the extension's own sections (a page of it gives the section a `sectionTitle`), one per section, and count rules its `problems` have. `format` names Sextant's own formats (extension-id, contribution-id, semver, entry-path, identifier, non-blank, json-path); `pattern` says the same as a regular expression for other validators (json-path has none: it is the JSONPath subset of CRD printer columns).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "author", "sextantApi", "entry", "permissions", "contributes"],
  "properties": {
    "$schema": {
      "description": "Lets an editor find this schema; Sextant ignores it.",
      "type": "string",
      "maxLength": 2048
    },
    "id": {
      "description": "Unique id: 3–64 characters, lowercase letters, digits, `.` and `-`; starts with a letter or digit, does not end with `.`, no `..`, not a Windows device name (`nul`, `con.x`, `com0`, …).",
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "format": "extension-id",
      "pattern": "^(?!.*\\.\\.)(?!(?:con|prn|aux|nul|com[0-9¹²³]|lpt[0-9¹²³])(?:\\.|$))[a-z0-9][a-z0-9.-]{1,62}[a-z0-9-]$"
    },
    "name": { "$ref": "#/$defs/title" },
    "version": {
      "description": "Semantic version (https://semver.org), e.g. 1.2.0 or 1.2.0-beta.1.",
      "type": "string",
      "maxLength": 64,
      "format": "semver",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "format": "non-blank",
      "pattern": "\\S"
    },
    "sextantApi": {
      "description": "Major version of the extension API the extension is written for; Sextant supports 1 to 4 (2 adds `contributes.problems`, `contributes.metricQueries` and `translations`, 3 adds `contributes.sectionBadges` and `contributes.commands`, 4 adds sources and `not` in problem rules, computed columns, action conditions, `contributes.kinds`, status patches, port-forwards, `contributes.menuItems`, `contributes.services` and `contributes.agentTools`). A newer Sextant keeps reading every version it once read (ADR-0142).",
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },
    "entry": {
      "description": "The HTML file every view opens, relative to the package root, e.g. index.html or dist/index.html; no part may start with `.`, be `node_modules` (any case), end with `.` or a space, or be a Windows device name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "format": "entry-path",
      "pattern": "^(?!/)(?!.*//)(?!(?:.*/)?(?:\\.|[nN][oO][dD][eE]_[mM][oO][dD][uU][lL][eE][sS](?:/|$)))(?!.*[. ](?:/|$))(?!(?:.*/)?(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][0-9¹²³]|[lL][pP][tT][0-9¹²³]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$) *(?:\\.[^/]*)?(?:/|$))[^\\\\:*?\\\"<>|\\u0000-\\u001f]*\\.[hH][tT][mM][lL]?$"
    },
    "icon": { "$ref": "#/$defs/icon" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "contributes": { "$ref": "#/$defs/contributes" },
    "backend": {
      "description": "Code that runs outside the window (ADR-0131): a WebAssembly component of the world sextant:extension/backend, the hosts it may call over HTTPS and the credentials the user enters for it. The consent screen shows each host and credential.",
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": {
          "description": "The component, relative to the package root, e.g. backend.wasm.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "format": "wasm-path"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hosts"],
          "properties": {
            "hosts": {
              "description": "Host names the backend may call over HTTPS on port 443: lower case, no wildcard, no IP address, not localhost.",
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3, "maxLength": 253, "format": "host-name" }
            }
          }
        },
        "credentials": {
          "description": "Secrets the user enters in Sextant for the backend (an API token, say); only this backend reads them. Ids are unique.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "label": { "$ref": "#/$defs/title" }
            }
          }
        }
      }
    },
    "translations": {
      "description": "Translations of the manifest's texts (sextantApi 2): language tag (`de`, `pt-BR`, `zh-CN`) → text key (`name`, `description`, `pages.<id>.title`, `problems.<id>.message`, …) → text. English is the manifest itself; a text not translated is shown in English. Metric queries, kinds and paths are never translated.",
      "type": "object",
      "maxProperties": 30,
      "additionalProperties": {
        "type": "object",
        "maxProperties": 300,
        "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  },
  "$defs": {
    "title": {
      "description": "Text shown to the user: 1–80 characters, not only spaces.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "format": "non-blank",
      "pattern": "\\S"
    },
    "contributionId": {
      "description": "1–40 characters: lowercase letters, digits and `-`; unique among contributions of the same type.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "contribution-id",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "icon": {
      "description": "Name of an icon from Sextant's set (e.g. `workloads`, `customResource`); an unknown name shows the default icon.",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "identifier",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$"
    },
    "order": {
      "description": "Position among siblings; smaller comes first.",
      "type": "integer",
      "minimum": -10000,
      "maximum": 10000
    },
    "kind": {
      "description": "A kind without a version: API group (`\"\"` for the core group) and kind, compared ignoring case.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "kind"],
      "properties": {
        "group": { "type": "string", "maxLength": 253 },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "format": "non-blank",
          "pattern": "\\S"
        }
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/kind" }
    },
    "permissions": {
      "description": "What the extension may do in clusters: clusters × namespaces × kinds × actions, as AI agent access rules.",
      "type": "object",
      "additionalProperties": false,
      "required": ["clusters", "rules"],
      "properties": {
        "clusters": {
          "description": "Clusters by kubeconfig context name: all of them, or only these.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "all" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "names"],
              "properties": {
                "type": { "const": "only" },
                "names": {
                  "type": "array",
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "format": "non-blank",
                    "pattern": "\\S"
                  }
                }
              }
            }
          ]
        },
        "statusPatches": {
          "description": "Kinds whose status subresource the extension may patch where the rules allow Modify (sextantApi 4): custom resources only.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/kind" }
        },
        "rules": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespaces", "kinds", "actions"],
      "properties": {
        "namespaces": {
          "description": "All namespaces (and objects without a namespace), or only these namespaces.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "all" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "namespaces"],
              "properties": {
                "type": { "const": "only" },
                "namespaces": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 63,
                    "format": "non-blank",
                    "pattern": "\\S"
                  }
                }
              }
            }
          ]
        },
        "kinds": {
          "description": "All kinds, or only these.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "all" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "kinds"],
              "properties": {
                "type": { "const": "only" },
                "kinds": { "$ref": "#/$defs/kinds" }
              }
            }
          ]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["read", "modify", "delete", "logs", "secretValues", "portForward"]
          }
        },
        "confirm": {
          "description": "Ask the user before every Modify or Delete this rule allows. Default: true.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "section"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "section": {
                "description": "A sidebar section of Sextant (`workloads`, `config`, `customResources`, …) or the extension's own.",
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "format": "identifier",
                "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$"
              },
              "sectionTitle": { "$ref": "#/$defs/title" },
              "icon": { "$ref": "#/$defs/icon" },
              "order": { "$ref": "#/$defs/order" }
            }
          }
        },
        "detailsSections": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "kinds", "placement"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "kinds": { "$ref": "#/$defs/kinds" },
              "order": { "$ref": "#/$defs/order" },
              "placement": { "type": "string", "enum": ["section", "tab"] }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "kinds"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "icon": { "$ref": "#/$defs/icon" },
              "kinds": { "$ref": "#/$defs/kinds" },
              "danger": { "type": "boolean", "default": false },
              "multiple": { "type": "boolean", "default": false },
              "when": {
                "description": "Offered only for objects for which this holds, as a problem rule's condition without `missing` (sextantApi 4).",
                "$ref": "#/$defs/problemCondition"
              },
              "whyNot": {
                "description": "Why the action is not offered where `when` does not hold (sextantApi 4).",
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "format": "non-blank",
                "pattern": "\\S"
              },
              "placement": {
                "description": "`primary`: a button of the details bar on kinds of the extension's own section (`contributes.kinds`); `more` (default): the \"Actions\" menu (sextantApi 4).",
                "type": "string",
                "enum": ["primary", "more"]
              }
            }
          }
        },
        "columns": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "title"],
            "properties": {
              "kind": { "$ref": "#/$defs/kind" },
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "jsonPath": {
                "description": "JSONPath as in CRD printer columns: .spec.size, .status.conditions[?(@.type==\"Ready\")].status, .metadata.labels['app\\.kubernetes\\.io/name'].",
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "format": "json-path"
              },
              "after": {
                "description": "Title of the column this one goes after; at the end when omitted or unknown.",
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "paths": {
                "description": "Field paths, the first with a value giving the cell; instead of `jsonPath` (sextantApi 4).",
                "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/fieldPath" }
              },
              "format": {
                "description": "How the value is shown, sorted and filtered: `text` (default), `number`, `age` (a time), `duration` (from the time to `endPaths` or now), `ratio` (`value/totalPaths`).",
                "type": "string",
                "enum": ["text", "number", "age", "duration", "ratio"]
              },
              "endPaths": {
                "description": "`duration`: the end time, the first with a value; now without one.",
                "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/fieldPath" }
              },
              "totalPaths": {
                "description": "`ratio`: the whole, the first with a value.",
                "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/fieldPath" }
              },
              "tones": {
                "description": "A tone per shown value: `ok`, `warning`, `error` or `neutral`.",
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": { "type": "string", "enum": ["ok", "warning", "error", "neutral"] }
              },
              "tooltipPaths": {
                "description": "The cell's tooltip, the first with a value.",
                "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/fieldPath" }
              },
              "cases": {
                "description": "Texts shown instead of the value where a condition holds, the first that holds.",
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["when", "text"],
                  "properties": {
                    "when": { "$ref": "#/$defs/problemCondition" },
                    "text": { "$ref": "#/$defs/title" }
                  }
                }
              }
            }
          }
        },
        "dockActions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "icon": { "$ref": "#/$defs/icon" }
            }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "$ref": "#/$defs/title" }
          }
        },
        "problems": {
          "description": "Problem rules Sextant evaluates on its own watches (ADR-0137); needs `sextantApi` 2. Paths must not read a Secret's values or another kind's inline secret fields.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/problemRule" }
        },
        "metricQueries": {
          "description": "Prometheus-compatible queries the extension runs by id with typed parameters (ADR-0138); needs `sextantApi` 2. The extension never sends PromQL.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/metricQuery" }
        },
        "commands": {
          "description": "Programs the extension runs by id in a container it names by labels, with typed parameters, never through a shell (ADR-0147); needs `sextantApi` 3. Each is agreed to word for word at install; one that `changes` something is confirmed every time.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/command" }
        },
        "kinds": {
          "description": "Kinds listed in a sidebar section of the extension's own with Sextant's tables, details and actions (sextantApi 4).",
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["group", "kind", "section"],
            "properties": {
              "group": { "type": "string", "minLength": 1, "maxLength": 253 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 100, "format": "non-blank", "pattern": "\\S" },
              "section": {
                "description": "A section of the extension's own: it, a page or another kind of it with this section has a `sectionTitle`.",
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "format": "identifier",
                "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$"
              },
              "sectionTitle": { "$ref": "#/$defs/title" },
              "title": { "$ref": "#/$defs/title" },
              "icon": { "$ref": "#/$defs/icon" },
              "order": { "$ref": "#/$defs/order" }
            }
          }
        },
        "menuItems": {
          "description": "Items of Sextant's menus that open the extension's window (sextantApi 4): `cluster` is a cluster's context menu.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "menu"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "icon": { "$ref": "#/$defs/icon" },
              "menu": { "type": "string", "enum": ["cluster"] }
            }
          }
        },
        "services": {
          "description": "Services inside a cluster the extension sends requests to through Sextant's own port forward (sextantApi 4), each agreed to at install.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "name", "port", "scheme"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "name": { "description": "The Service's name, in the namespace each request names.", "type": "string", "minLength": 1, "maxLength": 63 },
              "port": {
                "description": "The Service's port: its number or its name.",
                "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 65535 }, { "type": "string", "minLength": 1, "maxLength": 15 }]
              },
              "scheme": { "type": "string", "enum": ["https", "http"] }
            }
          }
        },
        "agentTools": {
          "description": "Tools for AI agents in Sextant's MCP server, answered by the extension's backend (sextantApi 4); agents get them only when the user turns the extension on in Settings → AI agents.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description", "inputSchema"],
            "properties": {
              "id": { "$ref": "#/$defs/contributionId" },
              "title": { "$ref": "#/$defs/title" },
              "description": {
                "description": "What the agent reads to choose the tool.",
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "format": "non-blank",
                "pattern": "\\S"
              },
              "inputSchema": { "description": "The JSON Schema of the arguments: an object, in a small subset Sextant checks.", "type": "object" },
              "readOnly": { "description": "It only reads (default false).", "type": "boolean" }
            }
          }
        },
        "sectionBadges": {
          "description": "Counters on the extension's own sidebar sections (ADR-0143); needs `sextantApi` 3. Sextant counts the objects with active problems of the extension's rules and shows the number on the section's header.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section"],
            "properties": {
              "section": {
                "description": "A section of the extension's own: one of its pages with this `section` has a `sectionTitle`.",
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "format": "identifier",
                "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$"
              },
              "rules": {
                "description": "The ids of the problem rules whose problems it counts; left out: every rule.",
                "type": "array",
                "maxItems": 20,
                "items": { "$ref": "#/$defs/contributionId" }
              }
            }
          }
        }
      }
    },
    "fieldPath": {
      "description": "A field path: `.status.phase`, `.items[0]`, `.metadata.labels[\"app\"]`; no wildcards or filters.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "problemValue": {
      "description": "A string, number or boolean.",
      "oneOf": [{ "type": "string", "maxLength": 256 }, { "type": "number" }, { "type": "boolean" }]
    },
    "problemRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "when", "message"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "kind": { "$ref": "#/$defs/kind" },
        "when": { "$ref": "#/$defs/problemCondition" },
        "since": { "$ref": "#/$defs/fieldPath" },
        "graceMinutes": {
          "description": "The problem counts only this long after it began (or was first seen).",
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "notify": { "description": "It may send a notification (the default); `false`: listed only.", "type": "boolean" },
        "toldThroughOwner": {
          "description": "Not told while the object's controller has a problem of this extension's rules (sextantApi 3).",
          "type": "boolean"
        },
        "newestPer": {
          "description": "A label key: of the objects of one namespace with the same value of this label, only the newest can have the problem (sextantApi 3).",
          "type": "string",
          "minLength": 1,
          "maxLength": 317
        },
        "source": {
          "description": "Which objects of the kind the rule sees (sextantApi 4): those a label selector picks, and only their metadata. Every rule of a kind has the same source.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labelSelector": {
              "description": "A Kubernetes label selector: `key`, `!key`, `key=value`, `key!=value`, `key in (a,b)`, `key notin (a,b)`, separated by commas.",
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "metadataOnly": {
              "description": "Only `apiVersion`, `kind` and `metadata` are watched; every path of the rule is then under `.metadata`.",
              "type": "boolean"
            }
          }
        },
        "message": {
          "description": "Text with at most 5 `{{<field path>}}` placeholders.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "format": "non-blank",
          "pattern": "\\S"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "target", "argv"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labelSelector", "container"],
          "properties": {
            "labelSelector": {
              "description": "`key=value` pairs separated by commas: the newest ready pod with these labels in the namespace the call names.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "container": { "type": "string", "minLength": 1, "maxLength": 63 }
          }
        },
        "argv": {
          "description": "The program and its arguments: words, or exactly `{{name}}` of a parameter, put in as one whole argument.",
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "params": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 40, "format": "identifier", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$" },
              "type": { "type": "string", "enum": ["int", "enum", "name"] },
              "values": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
              "min": { "type": "integer" },
              "max": { "type": "integer" }
            }
          }
        },
        "changes": { "description": "It changes something: the user confirms it every time. Default `false`.", "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "metricQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "query"],
      "properties": {
        "id": { "$ref": "#/$defs/contributionId" },
        "title": { "$ref": "#/$defs/title" },
        "query": {
          "description": "PromQL with `{{name}}` placeholders of `params`: a namespace, name or labelValue inside a \"…\" string, a duration outside strings; no comments.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "format": "non-blank",
          "pattern": "\\S"
        },
        "params": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 40, "format": "identifier", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$" },
              "type": {
                "description": "namespace: a DNS-1123 label; name: a DNS-1123 subdomain; labelValue: up to 256 characters without control characters; duration: 1m, 2m, 5m, 10m, 15m, 30m, 1h, 2h, 6h, 12h, 1d or 7d.",
                "enum": ["namespace", "name", "labelValue", "duration"]
              }
            }
          }
        },
        "range": {
          "description": "The query may also run over a range of up to `maxHours` back; without it, instant queries only.",
          "type": "object",
          "additionalProperties": false,
          "required": ["maxHours"],
          "properties": {
            "maxHours": { "type": "integer", "minimum": 1, "maximum": 168 }
          }
        }
      }
    },
    "problemCondition": {
      "description": "A condition of a problem rule, by `type`; `all` and `any` nest at most 3 deep, 20 conditions per rule.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "value"],
          "properties": {
            "type": { "const": "equals" },
            "path": { "$ref": "#/$defs/fieldPath" },
            "value": { "$ref": "#/$defs/problemValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "values"],
          "properties": {
            "type": { "const": "in" },
            "path": { "$ref": "#/$defs/fieldPath" },
            "values": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/problemValue" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "exists" },
            "path": { "$ref": "#/$defs/fieldPath" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "const": "absent" },
            "path": { "$ref": "#/$defs/fieldPath" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "conditionType", "status"],
          "properties": {
            "type": { "const": "condition" },
            "conditionType": { "type": "string", "minLength": 1, "maxLength": 100, "format": "non-blank", "pattern": "\\S" },
            "status": { "type": "string", "enum": ["True", "False", "Unknown"] },
            "reason": { "type": "string", "minLength": 1, "maxLength": 100, "format": "non-blank", "pattern": "\\S" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "value"],
          "properties": {
            "type": { "const": "above" },
            "path": { "$ref": "#/$defs/fieldPath" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "value"],
          "properties": {
            "type": { "const": "below" },
            "path": { "$ref": "#/$defs/fieldPath" },
            "value": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "minutes"],
          "properties": {
            "type": { "const": "olderThan" },
            "path": { "$ref": "#/$defs/fieldPath" },
            "minutes": { "type": "integer", "minimum": 1, "maximum": 525600 }
          }
        },
        {
          "description": "The text at `path` names no object of `kind` in the object's namespace (or, for a kind without namespaces, in the cluster); unknown while that list is not read in full. sextantApi 3; not inside `any`; never a Secret.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "kind"],
          "properties": {
            "type": { "const": "missing" },
            "path": { "$ref": "#/$defs/fieldPath" },
            "kind": { "$ref": "#/$defs/kind" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "of"],
          "properties": {
            "type": { "const": "all" },
            "of": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/problemCondition" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "of"],
          "properties": {
            "type": { "const": "any" },
            "of": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/problemCondition" } }
          }
        },
        {
          "description": "Holds where `of` does not (sextantApi 4); never around `missing`.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "of"],
          "properties": {
            "type": { "const": "not" },
            "of": { "$ref": "#/$defs/problemCondition" }
          }
        }
      ]
    }
  }
}
