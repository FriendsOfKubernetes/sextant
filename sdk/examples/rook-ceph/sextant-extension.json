{
  "$schema": "../../../crates/sextant-core/src/extensions/manifest.schema.json",
  "id": "sextant.rook-ceph",
  "name": "Rook Ceph",
  "version": "1.0.0",
  "description": "Rook Ceph clusters at a glance, read-only: Ceph health and its checks in plain words, capacity, versions, the daemons and CSI drivers, pools and filesystems with the storage classes and claims on them, charts from the Ceph mgr's metrics, and problems when Ceph is unhealthy or its status goes stale.",
  "author": "Sextant",
  "sextantApi": 2,
  "entry": "index.html",
  "icon": "storage",
  "permissions": {
    "clusters": {
      "type": "all"
    },
    "rules": [
      {
        "namespaces": {
          "type": "all"
        },
        "kinds": {
          "type": "only",
          "kinds": [
            {
              "group": "ceph.rook.io",
              "kind": "CephCluster"
            },
            {
              "group": "ceph.rook.io",
              "kind": "CephBlockPool"
            },
            {
              "group": "ceph.rook.io",
              "kind": "CephFilesystem"
            },
            {
              "group": "ceph.rook.io",
              "kind": "CephObjectStore"
            },
            {
              "group": "ceph.rook.io",
              "kind": "CephObjectStoreUser"
            },
            {
              "group": "ceph.rook.io",
              "kind": "CephNFS"
            },
            {
              "group": "ceph.rook.io",
              "kind": "CephClient"
            },
            {
              "group": "objectbucket.io",
              "kind": "ObjectBucketClaim"
            },
            {
              "group": "objectbucket.io",
              "kind": "ObjectBucket"
            },
            {
              "group": "",
              "kind": "Pod"
            },
            {
              "group": "",
              "kind": "PersistentVolumeClaim"
            },
            {
              "group": "storage.k8s.io",
              "kind": "StorageClass"
            }
          ]
        },
        "actions": [
          "read"
        ]
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "overview",
        "title": "Rook Ceph",
        "section": "storage",
        "icon": "storage"
      }
    ],
    "detailsSections": [
      {
        "id": "status",
        "title": "Ceph status",
        "kinds": [
          {
            "group": "ceph.rook.io",
            "kind": "CephCluster"
          }
        ],
        "placement": "section",
        "order": 40
      },
      {
        "id": "daemons",
        "title": "Daemons",
        "kinds": [
          {
            "group": "ceph.rook.io",
            "kind": "CephCluster"
          }
        ],
        "placement": "tab",
        "order": 10
      },
      {
        "id": "metrics",
        "title": "Metrics",
        "kinds": [
          {
            "group": "ceph.rook.io",
            "kind": "CephCluster"
          }
        ],
        "placement": "tab",
        "order": 20
      },
      {
        "id": "storage",
        "title": "Storage classes and claims",
        "kinds": [
          {
            "group": "ceph.rook.io",
            "kind": "CephBlockPool"
          },
          {
            "group": "ceph.rook.io",
            "kind": "CephFilesystem"
          },
          {
            "group": "ceph.rook.io",
            "kind": "CephObjectStore"
          }
        ],
        "placement": "section"
      }
    ],
    "columns": [
      {
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephCluster"
        },
        "id": "ceph-version",
        "title": "Ceph",
        "jsonPath": ".status.version.version",
        "after": "Health"
      }
    ],
    "problems": [
      {
        "id": "health-error",
        "title": "Ceph health error",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephCluster"
        },
        "when": {
          "type": "equals",
          "path": ".status.ceph.health",
          "value": "HEALTH_ERR"
        },
        "since": ".status.ceph.lastChanged",
        "message": "Ceph reports HEALTH_ERR; the cluster's Ceph status lists the health checks"
      },
      {
        "id": "cluster-failed",
        "title": "Rook cannot run the Ceph cluster",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephCluster"
        },
        "when": {
          "type": "equals",
          "path": ".status.phase",
          "value": "Failure"
        },
        "message": "Rook's phase is Failure: {{.status.message}}"
      },
      {
        "id": "health-warning",
        "title": "Ceph health warning",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephCluster"
        },
        "when": {
          "type": "equals",
          "path": ".status.ceph.health",
          "value": "HEALTH_WARN"
        },
        "since": ".status.ceph.lastChanged",
        "graceMinutes": 15,
        "message": "Ceph reports HEALTH_WARN since {{.status.ceph.lastChanged}}; the cluster's Ceph status lists the health checks"
      },
      {
        "id": "health-stale",
        "title": "Ceph status not refreshed",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephCluster"
        },
        "when": {
          "type": "olderThan",
          "path": ".status.ceph.lastChecked",
          "minutes": 15
        },
        "message": "Rook last checked Ceph's health at {{.status.ceph.lastChecked}}: is the Rook operator running?"
      },
      {
        "id": "pool-not-ready",
        "title": "Ceph block pool not ready",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephBlockPool"
        },
        "when": {
          "type": "in",
          "path": ".status.phase",
          "values": [
            "Failure",
            "Progressing",
            "Connecting"
          ]
        },
        "graceMinutes": 10,
        "message": "Phase {{.status.phase}} for 10 minutes. {{.status.message}}"
      },
      {
        "id": "pool-no-status",
        "title": "Ceph block pool without status",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephBlockPool"
        },
        "when": {
          "type": "absent",
          "path": ".status.phase"
        },
        "graceMinutes": 10,
        "message": "Rook has reported no phase for 10 minutes: is the Rook operator running?"
      },
      {
        "id": "filesystem-not-ready",
        "title": "Ceph filesystem not ready",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephFilesystem"
        },
        "when": {
          "type": "in",
          "path": ".status.phase",
          "values": [
            "Failure",
            "Progressing",
            "Connecting"
          ]
        },
        "graceMinutes": 10,
        "message": "Phase {{.status.phase}} for 10 minutes. {{.status.message}}"
      },
      {
        "id": "filesystem-no-status",
        "title": "Ceph filesystem without status",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephFilesystem"
        },
        "when": {
          "type": "absent",
          "path": ".status.phase"
        },
        "graceMinutes": 10,
        "message": "Rook has reported no phase for 10 minutes: is the Rook operator running?"
      },
      {
        "id": "object-store-not-ready",
        "title": "Ceph object store not ready",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephObjectStore"
        },
        "when": {
          "type": "in",
          "path": ".status.phase",
          "values": [
            "Failure",
            "Progressing",
            "Connecting"
          ]
        },
        "graceMinutes": 10,
        "message": "Phase {{.status.phase}} for 10 minutes. {{.status.message}}"
      },
      {
        "id": "object-store-no-status",
        "title": "Ceph object store without status",
        "kind": {
          "group": "ceph.rook.io",
          "kind": "CephObjectStore"
        },
        "when": {
          "type": "absent",
          "path": ".status.phase"
        },
        "graceMinutes": 10,
        "message": "Rook has reported no phase for 10 minutes: is the Rook operator running?"
      }
    ],
    "metricQueries": [
      {
        "id": "health",
        "title": "Ceph health (0 OK, 1 WARN, 2 ERR)",
        "query": "max(ceph_health_status{namespace=\"{{namespace}}\"})",
        "params": [
          {
            "name": "namespace",
            "type": "namespace"
          }
        ],
        "range": {
          "maxHours": 168
        }
      },
      {
        "id": "capacity",
        "title": "Raw capacity: total and used bytes",
        "query": "max by (__name__) ({__name__=~\"ceph_cluster_total_bytes|ceph_cluster_total_used_raw_bytes\",namespace=\"{{namespace}}\"})",
        "params": [
          {
            "name": "namespace",
            "type": "namespace"
          }
        ],
        "range": {
          "maxHours": 168
        }
      },
      {
        "id": "osds",
        "title": "OSDs up, in and in all",
        "query": "label_replace(sum(max by (ceph_daemon) (ceph_osd_up{namespace=\"{{namespace}}\"})), \"state\", \"up\", \"\", \"\") or label_replace(sum(max by (ceph_daemon) (ceph_osd_in{namespace=\"{{namespace}}\"})), \"state\", \"in\", \"\", \"\") or label_replace(count(max by (ceph_daemon) (ceph_osd_up{namespace=\"{{namespace}}\"})), \"state\", \"total\", \"\", \"\")",
        "params": [
          {
            "name": "namespace",
            "type": "namespace"
          }
        ],
        "range": {
          "maxHours": 168
        }
      },
      {
        "id": "pgs",
        "title": "Placement groups by state",
        "query": "sum by (__name__) (max by (__name__, pool_id) ({__name__=~\"ceph_pg_(total|active|clean|degraded|undersized|down|stale|peering|incomplete|inconsistent|recovering|backfilling|remapped)\",namespace=\"{{namespace}}\"}))",
        "params": [
          {
            "name": "namespace",
            "type": "namespace"
          }
        ],
        "range": {
          "maxHours": 168
        }
      }
    ]
  }
}
