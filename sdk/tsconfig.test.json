{
  // Tests (run by Node with jsdom) and the type checks in test/protocol.test.ts. They load Sextant's host side
  // (src/extensions/bridge.ts), so the options match the app's tsconfig.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "template/src", "examples/*/src", "vitest.config.ts"],
  "exclude": ["**/dist"]
}
