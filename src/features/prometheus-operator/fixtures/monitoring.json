{
  "serviceMonitor": {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "ServiceMonitor",
    "metadata": { "name": "example-app", "namespace": "default", "uid": "sm-example-app", "labels": { "team": "frontend" }, "creationTimestamp": "2026-10-01T10:00:00Z" },
    "spec": { "selector": { "matchLabels": { "app": "example-app" } }, "endpoints": [{ "port": "web" }, { "port": "metrics", "path": "/stats", "interval": "30s" }] }
  },
  "orphanMonitor": {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "ServiceMonitor",
    "metadata": { "name": "orphan", "namespace": "default", "uid": "sm-orphan", "labels": { "team": "backend" }, "creationTimestamp": "2026-10-01T10:00:00Z" },
    "spec": { "selector": { "matchLabels": { "app": "gone" } }, "endpoints": [{ "port": "web" }] }
  },
  "podMonitor": {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "PodMonitor",
    "metadata": { "name": "example-pods", "namespace": "default", "uid": "pm-example", "labels": { "team": "frontend" }, "creationTimestamp": "2026-10-01T10:00:00Z" },
    "spec": { "selector": { "matchLabels": { "app": "example-app" } }, "podMetricsEndpoints": [{ "port": "web" }] }
  },
  "prometheus": {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "Prometheus",
    "metadata": { "name": "prometheus", "namespace": "default", "uid": "prom-default", "creationTimestamp": "2026-10-01T10:00:00Z" },
    "spec": {
      "serviceAccountName": "prometheus",
      "replicas": 2,
      "serviceMonitorSelector": { "matchLabels": { "team": "frontend" } },
      "podMonitorSelector": { "matchLabels": { "team": "frontend" } },
      "ruleSelector": {},
      "resources": { "requests": { "memory": "400Mi" } }
    },
    "status": {
      "availableReplicas": 1,
      "replicas": 2,
      "conditions": [
        { "type": "Available", "status": "Degraded", "reason": "SomePodsNotReady", "message": "shard 0: pod prometheus-prometheus-1: containers with incomplete status: [init-config-reloader]", "lastTransitionTime": "2026-10-10T08:00:00Z" },
        { "type": "Reconciled", "status": "True", "lastTransitionTime": "2026-10-10T08:00:00Z" }
      ]
    }
  },
  "rule": {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "PrometheusRule",
    "metadata": { "name": "prometheus-example-rules", "namespace": "default", "uid": "rule-example", "labels": { "role": "alert-rules" }, "creationTimestamp": "2026-10-01T10:00:00Z" },
    "spec": {
      "groups": [
        { "name": "./example.rules", "rules": [{ "alert": "ExampleAlert", "expr": "vector(1)" }, { "record": "job:http_inprogress_requests:sum", "expr": "sum by (job) (http_inprogress_requests)" }] }
      ]
    }
  },
  "services": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": { "name": "example-app", "namespace": "default", "uid": "svc-example-app", "labels": { "app": "example-app" } },
      "spec": { "selector": { "app": "example-app" }, "ports": [{ "name": "web", "port": 8080 }] }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": { "name": "example-app-2", "namespace": "default", "uid": "svc-example-app-2", "labels": { "app": "example-app" } },
      "spec": { "selector": { "app": "example-app" }, "ports": [{ "name": "web", "port": 8080 }, { "name": "metrics", "port": 9090 }] }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": { "name": "other", "namespace": "default", "uid": "svc-other", "labels": { "app": "other" } },
      "spec": { "selector": { "app": "other" }, "ports": [{ "name": "http", "port": 80 }] }
    }
  ]
}
